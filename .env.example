# ── Network ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NETWORK=tron-mainnet

# TRON RPC (mainnet). Use a dedicated node provider; never commit credentials.
TRON_RPC_URL=https://api.tronstack.io
TRON_RPC_API_KEY=

# ── Treasury (read-only verification at startup) ─────────────────────────────
TREASURY_ADDRESS=T_TREASURY_ADDRESS
ACTIVE_PERMISSION_ID=2
ACTIVE_PERMISSION_NAME=Treasury payments
THRESHOLD=2

# Signer addresses (public only — never private keys)
SIGNER_A_ADDRESS=T_SIGNER_A
SIGNER_A_LABEL=Finance A
SIGNER_B_ADDRESS=T_SIGNER_B
SIGNER_B_LABEL=Finance B
SIGNER_C_ADDRESS=T_SIGNER_C
SIGNER_C_LABEL=Finance C

# USDT TRC-20
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_DECIMALS=6

# ── Payment policy ─────────────────────────────────────────────────────────
TRANSACTION_TTL_SECONDS=1800
MAX_PAYMENT_AMOUNT_RAW=1000000000
DAILY_CUMULATIVE_LIMIT_RAW=
RECIPIENT_ALLOWLIST_ENABLED=false
REQUIRED_CONFIRMATIONS_BEFORE_BROADCAST=1

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tron_payments
POSTGRES_PASSWORD=tron_payments_dev
POSTGRES_DB=tron_payments
DATABASE_URL=postgresql://tron_payments:tron_payments_dev@localhost:5432/tron_payments

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Auth (MVP: email+TOTP or OIDC — configure per environment)
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Web ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_NETWORK=tron-mainnet

# ── Signer client (local only) ───────────────────────────────────────────────
SIGNER_CLIENT_PORT=3847
SIGNER_LEDGER_DERIVATION_PATH=m/44'/195'/0'/0/0

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
