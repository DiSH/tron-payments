# ── Network ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NETWORK=tron-mainnet

# TRON RPC (mainnet). TronGrid: https://www.trongrid.io/ — never commit the key.
# When creating the key: leave AllowList Contract / User-Agent / Origins /
# Requested Api empty; JWT off. The API sends only TRON-PRO-API-KEY (no TronGrid JWT).
TRON_RPC_URL=https://api.trongrid.io
TRON_RPC_API_KEY=

# ── Token / payment policy (deployment config) ───────────────────────────────
# Treasury address, Active Permission, and three signer keys are configured in the
# web UI: Admin → Treasury Settings (stored in DB, validated against chain).
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_DECIMALS=6

TRANSACTION_TTL_SECONDS=1800
MAX_PAYMENT_AMOUNT_RAW=1000000000
DAILY_CUMULATIVE_LIMIT_RAW=
RECIPIENT_ALLOWLIST_ENABLED=false
REQUIRED_CONFIRMATIONS_BEFORE_BROADCAST=1

# ── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_* is used by local docker-compose.yml to create the Postgres container.
# The API always connects via DATABASE_URL (not POSTGRES_HOST).
# Local compose overrides DATABASE_URL to host `postgres` inside the network.
# Production compose has no Postgres service — point DATABASE_URL at your DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tron_payments
POSTGRES_PASSWORD=tron_payments_dev
POSTGRES_DB=tron_payments
DATABASE_URL=postgresql://tron_payments:tron_payments_dev@localhost:5432/tron_payments

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
# Production:
#   CORS_ORIGIN=https://fboardpagec.com
#   API_BASE_URL=https://fboardpagec.com
#   VITE_API_BASE_URL=https://fboardpagec.com
# Production compose hardcodes the web origin for CORS and the SPA build.

# Auth (email+password and/or Ledger WebHID challenge)
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Web ──────────────────────────────────────────────────────────────────────
# Browser-facing API URL. Local Vite reads this at runtime.
# Production nginx image bakes VITE_API_BASE_URL=https://fboardpagec.com at build
# (same-origin /api via the TLS reverse proxy).
VITE_API_BASE_URL=http://localhost:3000
VITE_NETWORK=tron-mainnet
# Ledger derivation path used by the Web SPA WebHID module
VITE_LEDGER_DERIVATION_PATH=m/44'/195'/0'/0/0

# Production Let's Encrypt (required by `bash scripts/init-letsencrypt.sh`)
CERTBOT_EMAIL=
# CERTBOT_STAGING=1

# Optional (dev seed only): bind a signer address when running seed-users.
# Prefer assigning addresses after Admin → Treasury Settings is saved.
# SIGNER_ADDRESS=

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
